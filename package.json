{
  "name": "solestia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:agent": "vite --port 5199 --strictPort",
    "build": "vue-tsc -b && vite build",
    "type-check": "vue-tsc -b",
    "test": "vitest run",
    "preview": "vite preview",
    "check": "npm run check:kepler && npm run check:calendars && npm run check:clocks && npm run check:mercury-time && npm run check:eclipses && npm run check:fields && npm run check:epicycles && npm run check:constellations",
    "check:constellations": "node --experimental-strip-types --no-warnings scripts/check-constellation-catalog.ts && node --experimental-strip-types --no-warnings scripts/check-constellation-geometry.ts && node --experimental-strip-types --no-warnings scripts/check-constellation-scene.ts && node --experimental-strip-types --no-warnings scripts/check-constellation-regions.ts && node --experimental-strip-types --no-warnings scripts/check-constellation-proper-names.ts",
    "check:fields": "node --experimental-strip-types --no-warnings scripts/check-fields.ts",
    "check:epicycles": "node --experimental-strip-types --no-warnings scripts/check-epicycles.ts",
    "check:eclipses": "node --experimental-strip-types --no-warnings scripts/check-eclipses.ts",
    "check:kepler": "node --experimental-strip-types --no-warnings scripts/check-kepler.ts",
    "check:calendars": "node --experimental-strip-types --no-warnings scripts/check-calendars.ts",
    "check:clocks": "node --experimental-strip-types --no-warnings scripts/check-clocks.ts",
    "check:mercury-time": "node --experimental-strip-types --no-warnings scripts/check-mercury-time.ts",
    "generate:asteroids": "node --experimental-strip-types --no-warnings scripts/generate-asteroid-ephemerides.ts && prettier --write src/data/generated/asteroidEphemerides.ts",
    "generate:land": "node --experimental-strip-types --no-warnings scripts/generate-earth-land.ts && prettier --write src/data/generated/earthLand.ts",
    "generate:kuiper": "node --experimental-strip-types --no-warnings scripts/generate-kuiper-ephemerides.ts && prettier --write src/data/generated/kuiperEphemerides.ts",
    "generate:solar-wind": "node --experimental-strip-types --no-warnings scripts/generate-solar-wind.ts && prettier --write src/data/generated/solarWind.ts",
    "generate:epicycles": "node --experimental-strip-types --no-warnings scripts/generate-epicycle-fits.ts && prettier --write src/data/generated/epicycleFits.ts",
    "generate:constellations": "node --experimental-strip-types --no-warnings scripts/generate-constellation-data.ts && prettier --write src/data/generated/constellations.ts",
    "generate:constellation-overlays": "node --experimental-strip-types --no-warnings scripts/generate-constellation-overlays.ts && prettier --write src/data/generated/romanBoundaries.ts src/data/generated/iauStarNames.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "metric-calendar": "1.0.1",
    "temporal-polyfill": "^1.0.4",
    "three": "^0.185.1",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.8.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "sass": "^1.85.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.8"
  }
}
