{
  "editor.formatOnSave": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },
  "eslint.useFlatConfig": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "vue"
  ],
  "cSpell.ignorePaths": [
    "src/test/*",
    "scripts/*",
    ".vscode/*",
    ".superpowers/*",
    ".playwright-mcp/*"
  ],
  "cSpell.words": [
    "Delporte",
    "ephemerides",
    "Hipparcos",
    "ICRF",
    "ICRS",
    "Karkoschka",
    "Karkoschka's",
    "Keplerian",
    "kuiper",
    "librations",
    "Seidelmann",
    "Solestia",
    "varpi",
    "WGCCRE",
    "WGSN"
  ]
}